{
  "rules": {
    ".write": false,
    "globalAdmins": {
      ".write": "auth != null && root.child('globalAdmins').child(auth.uid).val() == true",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('globalAdmins').child(auth.uid).val() == true)"
      }
    },
    "usuarios": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('globalAdmins').child(auth.uid).val() == true)",
        ".write": "auth != null && (auth.uid == $uid || root.child('globalAdmins').child(auth.uid).val() == true)"
      }
    },
    "tournaments": {
      "$tid": {
        ".read": true,
        ".write": "auth != null && (root.child('globalAdmins').child(auth.uid).val() == true || (!data.exists() && newData.child('ownerUid').val() == auth.uid && newData.child('paymentStatus').val() == 'pending' && newData.child('status').val() == 'draft') || (data.exists() && data.child('ownerUid').val() == auth.uid && data.child('paymentStatus').val() != 'paid' && newData.child('ownerUid').val() == auth.uid && newData.child('paymentStatus').val() != 'paid'))"
      },
      ".read": true,
      ".indexOn": [
        "ownerUid"
      ]
    },
    "payments": {
      "$pid": {
        ".read": "auth != null && (data.child('uid').val() == auth.uid || root.child('globalAdmins').child(auth.uid).val() == true)",
        ".write": false
      }
    },
    "tournamentAdmins": {
      ".read": "auth != null && root.child('globalAdmins').child(auth.uid).val() == true",
      "$tid": {
        ".read": "auth != null && (root.child('globalAdmins').child(auth.uid).val() == true || data.child(auth.uid).exists())",
        ".write": "auth != null && root.child('globalAdmins').child(auth.uid).val() == true"
      }
    },
    "equipos": {
      "$tid": {
        ".write": "auth != null && (root.child('globalAdmins').child(auth.uid).val() == true || root.child('tournaments').child($tid).child('ownerUid').val() == auth.uid || root.child('tournamentAdmins').child($tid).child(auth.uid).exists())"
      },
      ".read": true
    },
    "partidos": {
      "$tid": {
        ".write": "auth != null && (root.child('globalAdmins').child(auth.uid).val() == true || root.child('tournaments').child($tid).child('ownerUid').val() == auth.uid || root.child('tournamentAdmins').child($tid).child(auth.uid).exists())"
      },
      ".read": true
    },
    "eventos": {
      "$tid": {
        ".write": "auth != null && (root.child('globalAdmins').child(auth.uid).val() == true || root.child('tournaments').child($tid).child('ownerUid').val() == auth.uid || root.child('tournamentAdmins').child($tid).child(auth.uid).exists())"
      },
      ".read": true
    },
    "jugadores": {"$tid": {".read": true, ".write": "auth != null && (root.child('globalAdmins').child(auth.uid).val() == true || root.child('tournaments').child($tid).child('ownerUid').val() == auth.uid || root.child('tournamentAdmins').child($tid).child(auth.uid).exists())"}},
    "inscripciones": {
      "$tid": {
        ".read": true,
        "$rid": {
          ".write": "(auth != null && (root.child('globalAdmins').child(auth.uid).val() == true || root.child('tournaments').child($tid).child('ownerUid').val() == auth.uid || root.child('tournamentAdmins').child($tid).child(auth.uid).exists())) || (!data.exists() && newData.child('status').val() == 'pending' && newData.child('source').val() == 'public' && root.child('tournaments').child($tid).child('status').val() == 'active' && newData.child('team').isString() && newData.child('team').val().length > 0 && newData.child('team').val().length <= 100 && newData.child('delegate').isString() && newData.child('delegate').val().length <= 100 && newData.child('contact').isString() && newData.child('contact').val().length <= 40 && newData.child('email').isString() && newData.child('email').val().length <= 160 && newData.child('notes').isString() && newData.child('notes').val().length <= 500 && newData.child('tournamentId').val() == $tid)"
        }
      }
    },
    "sedes": {"$tid": {".read": true, ".write": "auth != null && (root.child('globalAdmins').child(auth.uid).val() == true || root.child('tournaments').child($tid).child('ownerUid').val() == auth.uid || root.child('tournamentAdmins').child($tid).child(auth.uid).exists())"}},
    "noticias": {"$tid": {".read": true, ".write": "auth != null && (root.child('globalAdmins').child(auth.uid).val() == true || root.child('tournaments').child($tid).child('ownerUid').val() == auth.uid || root.child('tournamentAdmins').child($tid).child(auth.uid).exists())"}},
    "patrocinadores": {"$tid": {".read": true, ".write": "auth != null && (root.child('globalAdmins').child(auth.uid).val() == true || root.child('tournaments').child($tid).child('ownerUid').val() == auth.uid || root.child('tournamentAdmins').child($tid).child(auth.uid).exists())"}},
    "premios": {"$tid": {".read": true, ".write": "auth != null && (root.child('globalAdmins').child(auth.uid).val() == true || root.child('tournaments').child($tid).child('ownerUid').val() == auth.uid || root.child('tournamentAdmins').child($tid).child(auth.uid).exists())"}},
    "paymentConfig": {
      "public": {
        ".read": true,
        ".write": "auth != null && root.child('globalAdmins').child(auth.uid).val() == true"
      },
      "payphone": {
        ".read": "auth != null && root.child('globalAdmins').child(auth.uid).val() == true",
        ".write": "auth != null && root.child('globalAdmins').child(auth.uid).val() == true"
      }
    },
    "paymentRequests": {
      "$pid": {
        ".read": "auth != null && (data.child('uid').val() == auth.uid || root.child('globalAdmins').child(auth.uid).val() == true)",
        ".write": "auth != null && (root.child('globalAdmins').child(auth.uid).val() == true || (!data.exists() && newData.child('uid').val() == auth.uid && root.child('tournaments').child(newData.child('tournamentId').val()).child('ownerUid').val() == auth.uid && newData.child('status').val() == 'pending'))"
      },
      ".indexOn": [
        "uid",
        "tournamentId"
      ],
      ".read": "auth != null && (root.child('globalAdmins').child(auth.uid).val() == true || (query.orderByChild == 'uid' && query.equalTo == auth.uid))"
    }
  }
}

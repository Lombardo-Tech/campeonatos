{
  "rules": {
    ".read": true,
    ".write": false,
    "globalAdmins": {
      ".write": "auth != null && root.child('globalAdmins').child(auth.uid).val() == true"
    },
    "tournaments": {
      ".write": "auth != null && root.child('globalAdmins').child(auth.uid).val() == true"
    },
    "tournamentAdmins": {
      "$tid": {
        ".write": "auth != null && root.child('globalAdmins').child(auth.uid).val() == true"
      }
    },
    "equipos": {
      "$tid": {
        ".write": "auth != null && (root.child('globalAdmins').child(auth.uid).val() == true || root.child('tournamentAdmins').child($tid).child(auth.uid).exists())"
      }
    },
    "partidos": {
      "$tid": {
        ".write": "auth != null && (root.child('globalAdmins').child(auth.uid).val() == true || root.child('tournamentAdmins').child($tid).child(auth.uid).exists())"
      }
    },
    "eventos": {
      "$tid": {
        ".write": "auth != null && (root.child('globalAdmins').child(auth.uid).val() == true || root.child('tournamentAdmins').child($tid).child(auth.uid).exists())"
      }
    }
  }
}
